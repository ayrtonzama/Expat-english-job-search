# Copy to .env at repo root before running `docker compose up`.
# Compose interpolates these into docker-compose.yml and passes them to the containers.

PORT=3000
# Host port the backend is published on (container still listens on 3000).
# Avoids clashing with Next.js dev server which defaults to 3000.
BACKEND_HOST_PORT=3001

# Frontend → backend base URL (server-side only; never exposed to the browser).
# Use http://backend:3000 if the frontend itself runs inside the compose network.
API_URL=http://localhost:3001

# Mongo root credentials — used to initialize the mongo container on first run.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_DB=expat_english

# Connection string the backend uses. Host is `mongo` (the compose service name).
MONGO_URI=mongodb://root:example@mongo:27017/expat_english?authSource=admin

# JWT signing secret — replace with a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
